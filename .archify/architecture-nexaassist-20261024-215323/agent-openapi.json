{
  "openapi": "3.1.0",
  "info": {
    "title": "NexaAssist Agent Service",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "type": "object",
                  "title": "Response Metrics Metrics Get"
                }
              }
            }
          }
        }
      }
    },
    "/agent": {
      "post": {
        "summary": "Agent",
        "operationId": "agent_agent_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "product_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^NXC-[0-9]{4}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "createCase",
                  "addCaseNote",
                  "escalateCase",
                  "createServiceRequest"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "jurisdiction": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Jurisdiction"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "AgentRequest"
      },
      "AgentResponse": {
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "policy_question",
              "missing_information",
              "forbidden",
              "customer_context",
              "supported_action"
            ],
            "title": "Intent"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "insufficient_evidence",
              "needs_clarification",
              "forbidden",
              "unavailable"
            ],
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "missing_fields": {
            "items": {
              "type": "string",
              "enum": [
                "product_id",
                "as_of",
                "customer_id",
                "action",
                "action_details",
                "question"
              ]
            },
            "type": "array",
            "title": "Missing Fields"
          },
          "answer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnswerResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "intent",
          "status",
          "message"
        ],
        "title": "AgentResponse"
      },
      "AnswerCitation": {
        "properties": {
          "evidence_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Evidence Id"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "title": "Quote"
          },
          "matched_child": {
            "$ref": "#/components/schemas/Citation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "quote",
          "matched_child"
        ],
        "title": "AnswerCitation"
      },
      "AnswerResponse": {
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "insufficient_evidence",
              "needs_clarification"
            ],
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/AnswerCitation"
            },
            "type": "array",
            "title": "Citations"
          },
          "retrieval_timings": {
            "$ref": "#/components/schemas/RetrieveTimings"
          },
          "generation_ms": {
            "type": "number",
            "title": "Generation Ms"
          },
          "datadog_span_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Datadog Span Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "as_of",
          "status",
          "answer",
          "citations",
          "retrieval_timings",
          "generation_ms"
        ],
        "title": "AnswerResponse"
      },
      "Citation": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version"
          },
          "clause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clause"
          },
          "effective_date": {
            "type": "string",
            "format": "date",
            "title": "Effective Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "doc_id",
          "title",
          "policy_version",
          "clause",
          "effective_date"
        ],
        "title": "Citation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RetrieveTimings": {
        "properties": {
          "search_ms": {
            "type": "number",
            "title": "Search Ms"
          },
          "parent_ms": {
            "type": "number",
            "title": "Parent Ms"
          },
          "total_ms": {
            "type": "number",
            "title": "Total Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "search_ms",
          "parent_ms",
          "total_ms"
        ],
        "title": "RetrieveTimings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
