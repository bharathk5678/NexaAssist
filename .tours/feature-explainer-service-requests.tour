{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Service requests: owner, reviewer and safe banking handoff",
  "description": "Feature-explainer tour of all service-request types and the approval403 boundary. Reads current working-tree files.",
  "steps": [
    {
      "file": "app/ui/agent.py",
      "line": 74,
      "title": "Start as the owner",
      "description": "The UI builds AgentRequest for the selected customer/type. Prepare uses the currently entered token; do not start under the reviewer identity."
    },
    {
      "file": "app/api/auth.py",
      "line": 16,
      "title": "Resolve staff identity and scope",
      "description": "The bearer token maps to configured principal_id, customer_ids and can_approve. Customer IDs in a request cannot grant access; a Bearer prefix pasted in the UI becomes part of the wrong token."
    },
    {
      "file": "app/api/agent_runs.py",
      "line": 24,
      "title": "Enter the durable API",
      "description": "Legacy training and unknown credentials are rejected with403. start/read/approve/retry delegate to the same scoped run service."
    },
    {
      "file": "app/services/agent_runs.py",
      "line": 170,
      "title": "Persist the creator",
      "description": "start stores the authenticated creator as owner_id, plus expiry and operation key. Reviewer-created runs cannot be self-approved even when that principal has review permission."
    },
    {
      "file": "app/agents/orchestrator.py",
      "line": 123,
      "title": "Retrieve the right policy",
      "description": "General requests including certificates search bank-wide POL-OPS-001 clause5.1. Only opt-in searches CIR-2026-07 clause5.2 with the NEXA-HL product scope."
    },
    {
      "file": "app/services/validation.py",
      "line": 54,
      "title": "Check the use-case facts",
      "description": "The validator reads accounts and checks owned loans. Certificates need a loan; general requests may omit it. Opt-in delegates to validate_opt_in with stricter policy/version, sanction and current flag checks."
    },
    {
      "file": "app/agents/orchestrator.py",
      "line": 234,
      "title": "Pause for the human handoff",
      "description": "interrupt persists the exact proposal/evidence hash. Copy the run ID, switch to reviewer, reload it, inspect evidence, select decision and confirm. Reject is subject to the same permission gate as approve."
    },
    {
      "file": "app/services/agent_runs.py",
      "line": 192,
      "title": "Locate the403 source",
      "description": "The service first requires can_approve, then checks scoped visibility, then rejects caller==owner_id. Expired or mismatched proposals fail later with409. Do not loosen this gate to repair UI role confusion."
    },
    {
      "file": "app/agents/orchestrator.py",
      "line": 256,
      "title": "Recheck before execution",
      "description": "On approval the workflow refreshes evidence and customer facts and compares the approved digest. Changed proposals block execution; rejected proposals never reach this node."
    },
    {
      "file": "app/services/service_requests.py",
      "line": 17,
      "title": "Submit and verify a receipt",
      "description": "A validated exact proposal is posted with the persisted Idempotency-Key. The receipt must match customer/type/loan; RECEIVED is not a generated certificate or completed downstream operation."
    },
    {
      "file": "nexa_synthetic_data/api/mock_server/server.py",
      "line": 163,
      "title": "Understand safe recovery",
      "description": "The mock caches operation outcomes in memory for24hours. The Agent applies a23hour safe retry window. Retry uncertain writes through the same run; resetting/restarting the mock discards replay protection."
    }
  ]
}
