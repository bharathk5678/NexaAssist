# MongoDB Atlas (cluster tier must support Vector Search)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=nexaassist
MONGODB_COLLECTION=policy_chunks
VECTOR_INDEX_NAME=policy_chunks_v1
MONGODB_PARENT_COLLECTION=policy_sections

# OpenAI (embeddings for retrieval, chat model for Week 2 answers)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
CHAT_MODEL=gpt-6-luna
# Optional evaluation judge
EVAL_JUDGE_MODEL=gpt-6.1-sol
# Retrieval: hybrid requires the manual Atlas text index in app/database/indexes.md.
RETRIEVAL_MODE=dense
TEXT_INDEX_NAME=policy_text_v1
RETRIEVAL_CANDIDATES=20
# Enable only after app.evaluation.check_reranker passes for your local runtime.
RERANK_ENABLED=false
RERANK_MODEL=nexaassist-reranker:0.6b-mlx
RERANK_API=ollama
RERANK_BASE_URL=http://127.0.0.1:11434
RERANK_API_KEY=ollama
RERANK_MAX_TOKENS=4000
# Verified optional local profile; keep ordinary dense mode for baseline comparisons.
# RERANK_API=llamacpp
# RERANK_BASE_URL=http://127.0.0.1:18516
# RERANK_MODEL=qwen3-reranker
# RERANKER_MODEL_FILE=/absolute/path/to/verified-Qwen3-Reranker-0.6B.Q8_0.gguf
# Start with: docker compose -f app/compose.reranker.yaml up -d
CONTEXT_MAX_TOKENS=6000
TOKEN_ENCODING=o200k_base

# Chunking (tunable without a redeploy)
CHUNK_MAX_CHARACTERS=1200
CHUNK_OVERLAP_CHARACTERS=150

# Corpus-wide metadata stamped on every chunk
INSTITUTION=NexaBank
JURISDICTION=IN
CONFIDENTIALITY_LEVEL=internal

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Required for feedback listing/review. Enter it only in the review workspace.
FEEDBACK_REVIEWER_TOKEN=

# Logging
LOG_LEVEL=INFO

# Datadog (load .env before ddtrace-run; use app/compose.datadog.yaml)
DD_TRACE_ENABLED=true
DD_SERVICE=nexaassist-api
DD_ENV=dev
DD_VERSION=0.1.0
DD_SITE=datadoghq.com
# Published Docker ports for applications running on this Mac.
DD_TRACE_AGENT_URL=http://127.0.0.1:18126
DD_DOGSTATSD_URL=udp://127.0.0.1:18125
DD_LOGS_INJECTION=true
DD_RUNTIME_METRICS_ENABLED=true
DD_LLMOBS_ENABLED=true
# The installed SDK uses DD_SERVICE to identify the LLM application.
DD_LLMOBS_AGENTLESS_ENABLED=false
# Used by the local Agent setup; never commit a real key.
DD_API_KEY=

# Phase 2 Agent Service; Phase 1 remains on port 8000.
RAG_BASE_URL=http://127.0.0.1:8000/
AGENT_HTTP_TIMEOUT_SECONDS=60
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_API_BASE_URL=http://127.0.0.1:8001
# Per-request model work; retries reserve twice the estimated input/output tokens.
AGENT_MODEL_MAX_OUTPUT_TOKENS=2048
AGENT_MODEL_MAX_CALLS=3
AGENT_MODEL_TOKEN_BUDGET=64000

# Validator training scope; disabled until both tokens and a customer allowlist are configured.
# Generate a separate caller token of at least 32 characters; never commit real tokens.
AGENT_VALIDATION_TOKEN=
AGENT_ALLOWED_CUSTOMER_IDS=[]
BANKING_BASE_URL=http://127.0.0.1:8080/
# The standalone synthetic banking mock accepts any nonempty bearer token.
BANKING_API_TOKEN=

# Four-agent workflows: distinct named owner/reviewer credentials and customer scopes.
# JSON example is in app/agents/README.md. Supply real tokens through your secret manager.
AGENT_PRINCIPALS=[]
AGENT_ALLOW_DIRECT_SUBMIT=false
AGENT_APPROVAL_TTL_SECONDS=900
MONGODB_AGENT_RUNS_COLLECTION=agent_runs
MONGODB_AGENT_CHECKPOINTS_COLLECTION=agent_checkpoints
MONGODB_AGENT_WRITES_COLLECTION=agent_checkpoint_writes
# Training default: seven days. Must exceed the 23-hour uncertain-write retry window.
MONGODB_AGENT_RETENTION_SECONDS=604800
